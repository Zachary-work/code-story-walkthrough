{
  "name": "code-story-walkthrough",
  "displayName": "Code Story Walkthrough",
  "description": "Review a change as stories: each one starts at an entry point and follows the calls down to the code that changed. Works with an AI agent skill that writes the stories and answers your review comments.",
  "version": "0.4.3",
  "icon": "media/icon.png",
  "publisher": "code-story-walkthrough",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zachary-work/code-story-walkthrough.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "workspaceContains:.stories/stories.json",
    "workspaceContains:.stories/*/stories.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeStories.open",
        "title": "Open Story Panel",
        "category": "Code Stories",
        "icon": "$(book)"
      },
      {
        "command": "codeStories.openStory",
        "title": "Open Story",
        "category": "Code Stories"
      },
      {
        "command": "codeStories.nextStep",
        "title": "Next Step",
        "category": "Code Stories"
      },
      {
        "command": "codeStories.prevStep",
        "title": "Previous Step",
        "category": "Code Stories"
      },
      {
        "command": "codeStories.showUnstoried",
        "title": "View Changes Not in a Story",
        "category": "Code Stories"
      },
      {
        "command": "codeStories.switchSet",
        "title": "Switch Story Set",
        "category": "Code Stories",
        "icon": "$(list-selection)"
      },
      {
        "command": "codeStories.deleteSet",
        "title": "Delete the Story Set on Screen",
        "category": "Code Stories"
      },
      {
        "command": "codeStories.linkPr",
        "title": "Link a Pull Request",
        "category": "Code Stories"
      },
      {
        "command": "codeStories.unlinkPr",
        "title": "Unlink Pull Request",
        "category": "Code Stories"
      },
      {
        "command": "codeStories.refreshPrComments",
        "title": "Fetch Replies from Pull Request",
        "category": "Code Stories"
      },
      {
        "command": "codeStories.copyAgentPrompt",
        "title": "Copy Agent Prompt for Review Comments",
        "category": "Code Stories"
      },
      {
        "command": "codeStories.installSkill",
        "title": "Install Agent Skill",
        "category": "Code Stories"
      },
      {
        "command": "codeStories.comment.local",
        "title": "Comment locally"
      },
      {
        "command": "codeStories.comment.pr",
        "title": "Comment on PR"
      },
      {
        "command": "codeStories.comment.prLink",
        "title": "Comment on PR (link a PR first)"
      },
      {
        "command": "codeStories.comment.reply",
        "title": "Reply"
      },
      {
        "command": "codeStories.comment.resolve",
        "title": "Resolve",
        "icon": "$(check)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeStories",
          "title": "Code Stories",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codeStories": [
        {
          "id": "codeStories.stories",
          "name": "Stories"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeStories.stories",
        "contents": "No stories in this workspace yet.\n\nStories are written by your AI agent into .stories/, one folder per change. Install the skill, then ask the agent: \"/code-stories create stories for this branch\".\n\n[Install Agent Skill](command:codeStories.installSkill)\n\n[Open Story Panel](command:codeStories.open)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeStories.open",
          "when": "view == codeStories.stories",
          "group": "navigation"
        },
        {
          "command": "codeStories.switchSet",
          "when": "view == codeStories.stories",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "codeStories.openStory",
          "when": "false"
        },
        {
          "command": "codeStories.comment.local",
          "when": "false"
        },
        {
          "command": "codeStories.comment.pr",
          "when": "false"
        },
        {
          "command": "codeStories.comment.prLink",
          "when": "false"
        },
        {
          "command": "codeStories.comment.reply",
          "when": "false"
        },
        {
          "command": "codeStories.comment.resolve",
          "when": "false"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "codeStories.comment.local",
          "group": "inline@1",
          "when": "commentController == codeStories && commentThreadIsEmpty"
        },
        {
          "command": "codeStories.comment.pr",
          "group": "inline@2",
          "when": "commentController == codeStories && commentThreadIsEmpty && codeStories.prLinked"
        },
        {
          "command": "codeStories.comment.prLink",
          "group": "inline@2",
          "when": "commentController == codeStories && commentThreadIsEmpty && !codeStories.prLinked"
        },
        {
          "command": "codeStories.comment.reply",
          "group": "inline@1",
          "when": "commentController == codeStories && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "codeStories.comment.resolve",
          "group": "navigation",
          "when": "commentController == codeStories && !commentThreadIsEmpty"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
